<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Dayalogue</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Export compliance (12 settembre 2026). La cassaforte cifra le
	     giornate con AES-256-GCM e PBKDF2 di WebCrypto (crypto.subtle),
	     cioe la cifratura del sistema operativo Apple dentro WKWebView;
	     nessuna libreria di cifratura di terze parti (controllato in
	     package.json e nei pod). Per la tabella di App Store Connect
	     "Export compliance documentation for encryption" e il caso
	     "encryption limited to that within the Apple operating system":
	     esente, nessun documento. Quindi NO.
	     Il primo tentativo con YES e senza ITSEncryptionExportComplianceCode
	     ha fatto fallire l'upload da xcodebuild ("Invalid Export Compliance
	     Code"): con YES Apple pretende il codice dei documenti caricati.
	     La dichiarazione di autoclassificazione annuale al governo USA
	     resta a carico nostro. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>dayalogue usa il microfono per registrare il racconto della tua giornata. L'audio resta sul telefono: viene trascritto e poi scartato, si salva solo il testo.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>dayalogue usa Face ID per aprire il diario solo a te.</string>
	<key>NSCameraUsageDescription</key>
	<string>dayalogue usa la fotocamera solo quando scegli di scattare una foto per il profilo o per la giornata. Nessuna foto viene scattata da sola.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>dayalogue accede al rullino solo quando scegli una foto per il profilo o per la giornata. Vengono lette solo le foto che scegli tu.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
