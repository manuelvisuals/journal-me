<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Il manifesto della privacy (obbligatorio dal 2024). Deve dire la stessa
	     cosa delle etichette App Privacy in App Store Connect e di
	     dayalogue.com/privacy. Niente tracciamento, nessun dominio di
	     tracciamento. I dati, gli STESSI delle etichette pubblicate in App
	     Store Connect (verificate il 15 settembre 2026): email, nome, id
	     utente, il diario (testo e foto, cifrati), peso/sonno/umore (Health),
	     l'identificativo del dispositivo (il braccialetto / DeviceCheck), la
	     cronologia acquisti (Apple), i consumi AI (Other Usage Data). In piu
	     l'audio, in transito per la trascrizione e non conservato. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
